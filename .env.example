# NEXUS AI Environment Configuration

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Authentication
JWT_SECRET=nexus_ai_super_secure_jwt_secret_key_2026_hackathon_elite

# Artificial Intelligence (Google Gemini)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Database (Supabase / PostgreSQL)
# If left empty, NEXUS AI automatically runs on the built-in local database engine with complete demo seed data!
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# External Integrations (Optional)
# Resend Email Integration (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key

# Currency Conversion API (Frankfurter.app is free and requires no key)
EXCHANGE_RATE_API_URL=https://api.frankfurter.app

# Demo Mode & Safety
DEMO_MODE=true
ENABLE_HUMAN_APPROVAL=true
MAX_AGENT_TURNS=10
